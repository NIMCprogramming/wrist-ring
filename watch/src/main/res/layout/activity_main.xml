<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C1824"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="22dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/icon_plate"
        android:contentDescription="@null"
        android:padding="12dp"
        android:src="@drawable/ic_wrist_ring"
        android:tint="#F6B94F" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/status_waiting"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <Button
        android:id="@+id/monitoring"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#E9A23B"
        android:fontFamily="sans-serif-medium"
        android:minWidth="120dp"
        android:text="@string/start_monitoring"
        android:textAllCaps="false"
        android:textColor="#0C1824" />
</LinearLayout>
